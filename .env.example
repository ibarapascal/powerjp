# 复制为 .env 后填入实际值。.env 已在 .gitignore 中，永不进 git。

# --- OCCTO 系統情報サービス（潮流实绩，assisted ingest）---
OCCTO_USERNAME=
OCCTO_PASSWORD=

# --- Cloudflare R2（产物发布）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Mapbox（前端底图。必须在 Mapbox 后台配 URL 白名单）---
VITE_MAPBOX_TOKEN=

# --- PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=powerjp
POSTGRES_USER=powerjp
POSTGRES_PASSWORD=

# --- Dagster ---
# 与同机其他 Dagster 实例错开端口
DAGSTER_HOME=
