# 复制为 .env 后填入实际值。.env 已在 .gitignore 中，永不进 git。

# --- OCCTO 系統情報サービス（潮流实绩，assisted ingest）---
OCCTO_USERNAME=
OCCTO_PASSWORD=

# --- Cloudflare R2（产物发布）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 默认由 account id 推导 https://<account-id>.r2.cloudflarestorage.com；
# 有自定义 S3 endpoint 时才填写。
R2_ENDPOINT=
# R2 bucket 内的发布前缀。VITE_DATA_BASE 应指向这个前缀对应的 CDN 路径。
R2_PREFIX=powerjp/v1
# 发布成功后清理不再被当前 manifest 引用的旧 hash 对象；私有计算节点 raw 历史不受影响。
# grace window 用于让刚好拿着上一版 manifest 的浏览器完成读取。
R2_PRUNE_ORPHANS=1
R2_PRUNE_GRACE_HOURS=6

# --- publish 新鲜度告警（可选；不填则只写日志并返回非零退出码）---
POWERJP_FRESHNESS_WEBHOOK_URL=
POWERJP_FRESHNESS_MAX_AGE_MINUTES=120

# --- Mapbox（前端底图。必须在 Mapbox 后台配 URL 白名单）---
VITE_MAPBOX_TOKEN=

# --- PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=powerjp
POSTGRES_USER=powerjp
POSTGRES_PASSWORD=

# --- Dagster ---
# 与同机其他 Dagster 实例错开端口
DAGSTER_HOME=
